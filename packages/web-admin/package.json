{
  "name": "@classhelper/web-admin",
  "version": "1.1.0",
  "private": true,
  "description": "班级小助手 Web 管理端（Vue 3 + Vite + Element Plus）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../scripts/check-icons.mjs && vue-tsc --noEmit -p tsconfig.json && vite build",
