    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@classhelper/shared": "workspace:*",
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.20.0",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
