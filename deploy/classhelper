${C_BOLD}班级小助手 · 运维命令${C_RESET}

用法：classhelper <子命令> [参数]

${C_BOLD}查看与诊断${C_RESET}
  status [--json]                服务状态、版本、端口、数据库、各类路径（--json 便于接监控）
  doctor                         完整体检（权限 / Node / 服务单元 / 探针 / 数据库 / 磁盘 / 备份）
  logs [-f] [-n N] [--since T]   查看日志（-f 实时跟随；--unit classhelper-backup 看定时备份）

${C_BOLD}账号${C_RESET}
  password [用户名]              修改密码（默认 admin）；交互输入、不回显、不进历史
  password --list                列出可登录账号与班级账号（含是否已设密码）
  password --class <班级码>      修改班级密码（学生端用「班级码 + 班级密码」登录）

${C_BOLD}备份与恢复${C_RESET}
  backup [--note 说明] [--keep N]    备份配置 + 数据库到 ${BACKUP_DIR}
  backup list                        列出备份与程序快照
  backup restore <备份目录名>        用某个备份覆盖当前配置与数据（会先停服务）
  backup schedule daily|weekly|off   启用 / 关闭定时备份（systemd timer）

${C_BOLD}升级与回滚${C_RESET}
  upgrade --check                检查 GitHub Release 上有没有新版本
  upgrade                        升级到最新版（下载 → 校验 sha256 → 备份 → 替换 → 探针，失败自动回滚）
  upgrade --version 1.2.0        升级到指定版本
  upgrade --url <tar.gz|file://路径> [--sha256 H] [--force]   内网离线分发 / 强制重装同版本
  rollback [--list] [--to X]     回滚程序文件到某个快照

${C_BOLD}服务与配置${C_RESET}
  start | stop | restart | reload     封装 systemctl / docker compose
  config show [--reveal]              查看配置（敏感值默认打码）
  config get <KEY>                    读取某项（敏感项自动打码）
  config set <KEY> <VALUE>            修改某项（敏感项改为交互输入），改完询问是否重启
  config edit                         用 \$EDITOR 编辑配置（改前自动备份）
  port [新端口]                       查看或修改服务端口
  key rotate                          轮换 JWT_SECRET（所有用户需重新登录）

${C_BOLD}其它${C_RESET}
  version                            显示版本
  help                               显示本帮助
  completion bash|zsh                生成补全脚本（chmod +x 后 source，或装到 completions 目录）

${C_DIM}敏感操作需要 root：sudo classhelper <子命令>
审计日志：${AUDIT_LOG}${C_RESET}
EOF
}

# ---------------------------------------------------------------- 12. 入口

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    # 不需要 root 的三个
    help|-h|--help)       cmd_help ;;
    version|-v|--version) printf 'classhelper %s（%s 形态）\n' "$(current_version)" "$MODE" ;;
    completion)           cmd_completion "$@" ;;

    status)   cmd_status "$@" ;;
    doctor)   cmd_doctor "$@" ;;
    password) cmd_password "$@" ;;
    backup)   cmd_backup "$@" ;;
    upgrade)  cmd_upgrade "$@" ;;
    rollback) cmd_rollback "$@" ;;

    start|stop|restart|reload)
      need_root "$cmd"
      require_install
      case "$cmd" in
        start)   svc_start ;;
        stop)    svc_stop ;;
        restart) svc_restart ;;
        # 服务端没有 SIGHUP 处理，reload 与 restart 同义（保持命令面一致，并说明清楚）
        reload)  info "服务端不支持热重载，按重启处理"; svc_restart ;;
      esac
      if [ "$cmd" = "stop" ]; then
        log "已停止"
      else
        if wait_ready 90; then log "服务已就绪 ✅（http://$(first_ip):$(current_port)/）"
        else print_recent_logs; die "服务在 90 秒内没有通过探针"; fi
      fi
      audit "$cmd" "$SERVICE_NAME" ok
      ;;

    logs)      cmd_logs "$@" ;;
    config)    cmd_config "$@" ;;
    port)      cmd_port "$@" ;;
    key)       cmd_key "$@" ;;
    uninstall) cmd_uninstall "$@" ;;

    *) warn "未知子命令：${cmd}"; printf '\n'; cmd_help; exit 2 ;;
  esac
}

main "$@"
