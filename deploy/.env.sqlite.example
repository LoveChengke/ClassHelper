# ---------------------------------------------------------------------------
# 班级小助手 · Docker 单容器（SQLite）环境变量
# 复制为 deploy/.env.sqlite 后填写：cp deploy/.env.sqlite.example deploy/.env.sqlite
# 配合 deploy/docker-compose.sqlite.yml 使用
# ---------------------------------------------------------------------------

# 服务端对外端口（宿主机）。注意与同机其他服务错开：80/443 常被反代占用
SERVER_PORT=4000

# 应用版本（镜像标签）
APP_VERSION=1.1.2

# JWT 签名密钥（必填，必须 ≥32 位；不能包含 secret / change-me 等示例词）
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 令牌有效期
JWT_EXPIRES_IN=7d

# 允许的跨域来源；用域名访问时建议写成具体来源，例如 https://class.example.com
CORS_ORIGIN=*

# 首次启动创建的管理员账号（**部署后请立即登录修改密码**）
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

# 各类账号的默认初始密码（新增/重置时使用）

DEFAULT_CLASS_PASSWORD=123456
DEFAULT_TEACHER_PASSWORD=123456

# 第 1 教学周的周一（用于"当前周次"）
TERM_START_DATE=2026-08-31

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
